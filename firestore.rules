rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ───────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && getUserRole() == 'admin';
    }

    function isCoach() {
      return isSignedIn() && (getUserRole() == 'coach' || getUserRole() == 'admin');
    }

    function isLinkedPlayer(playerId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedPlayerId == playerId;
    }

    // ─── Users ──────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isSignedIn() && (isOwner(uid) || isCoach());
      allow create: if isAdmin();
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }


    // ─── Invites ──────────────────────────────────────────────
    match /invites/{inviteId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.email == request.auth.token.email);
      allow create: if isAdmin();
      allow update: if isAdmin() ||
        (isSignedIn() && resource.data.email == request.auth.token.email &&
         request.resource.data.claimed == true);
      allow delete: if isAdmin();
    }

    // ─── Players ────────────────────────────────────────────
    match /players/{playerId} {
      allow read: if isSignedIn();
      allow write: if isCoach();

      // Sub-collections (maxEntries, combineResults, gameStats)
      match /{subcollection}/{docId} {
        allow read: if isSignedIn() && (isLinkedPlayer(playerId) || isCoach());
        allow write: if isCoach();
      }
    }

    // ─── Player Preferences ─────────────────────────────────
    match /playerPreferences/{playerId} {
      allow read: if isSignedIn() && (isLinkedPlayer(playerId) || isCoach());
      allow write: if isSignedIn() && isLinkedPlayer(playerId);
    }

    // ─── Coaches ────────────────────────────────────────────
    match /coaches/{coachId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ─── Games ──────────────────────────────────────────────
    match /games/{gameId} {
      allow read: if isSignedIn();
      allow write: if isCoach();
    }

    // ─── Calendar Events ────────────────────────────────────
    match /calendarEvents/{eventId} {
      allow read: if isSignedIn();
      allow write: if isCoach();
    }

    // ─── Workout Programs ───────────────────────────────────
    match /workoutPrograms/{programId} {
      allow read: if isSignedIn();
      allow write: if isCoach();
    }

    // ─── Announcements ──────────────────────────────────────
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if isCoach();
    }

    // ─── Recruiting Profiles ────────────────────────────────
    match /recruitingProfiles/{playerId} {
      allow read: if isSignedIn() && (isLinkedPlayer(playerId) || isCoach());
      allow write: if isSignedIn() && (isLinkedPlayer(playerId) || isCoach());
    }

    // ─── Depth Charts ───────────────────────────────────────
    match /depthCharts/{chartId} {
      allow read: if isSignedIn();
      allow write: if isCoach();
    }

    // ─── Game Awards ────────────────────────────────────────
    match /gameAwards/{awardId} {
      allow read: if isSignedIn();
      allow write: if isCoach();
    }

    // ─── Hudl Films ─────────────────────────────────────────
    match /hudlFilms/{filmId} {
      allow read: if isSignedIn();
      allow write: if isCoach();

      // Play breakdown sub-collection
      match /plays/{playId} {
        allow read: if isSignedIn();
        allow write: if isCoach();
      }
    }

    // ─── Hudl Player Stats ────────────────────────────────────
    match /hudlPlayerStats/{statId} {
      allow read: if isSignedIn();
      allow write: if isCoach();
    }

    // ─── Agent Sessions (analytics) ─────────────────────────
    match /agentSessions/{sessionId} {
      allow read: if isCoach();
      allow create: if isSignedIn();
    }

    // ─── Analytics ──────────────────────────────────────────
    match /analytics/{document=**} {
      allow read: if isAdmin();
      allow write: if false; // Only Cloud Functions write analytics
    }

    // ─── Player Chat (E2E Encrypted) ──────────────────────
    function isPlayerRole() {
      return isSignedIn() && getUserRole() == 'player';
    }

    match /chatRooms/{roomId} {
      allow read: if isSignedIn() &&
        request.auth.uid in resource.data.participantUids;

      allow create: if isPlayerRole() &&
        request.auth.uid in request.resource.data.participantUids &&
        request.resource.data.participantUids.size() >= 2 &&
        request.resource.data.participantUids.size() <= 50;

      allow update: if isSignedIn() &&
        request.auth.uid in resource.data.participantUids;

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.participantUids;

        allow create: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.participantUids &&
          request.resource.data.senderUid == request.auth.uid;

        allow update: if false;
        allow delete: if false;
      }
    }

    // ─── Compliant Broadcasts (one-to-many, role-targeted) ──
    //
    // Oversight model — the opposite of the E2E chat above. Broadcasts are
    // plaintext and admin-auditable on purpose: transparency is the
    // student-safety mechanism. Sends go exclusively through the
    // `sendBroadcast` Cloud Function (Admin SDK bypasses these rules), so
    // clients are NOT allowed to create broadcasts directly — that's what
    // guarantees server-side role-only audience resolution and audit logging.

    function isMuted() {
      return exists(/databases/$(database)/documents/mutes/$(request.auth.uid));
    }

    match /broadcasts/{broadcastId} {
      // Recipients can read broadcasts addressed to them; staff read all.
      allow read: if isSignedIn() &&
        (isCoach() || request.auth.uid in resource.data.recipientUids);

      // Only the Cloud Function creates/sends broadcasts.
      allow create: if false;

      // Members may only append themselves to readBy (read receipts). Staff may
      // update freely (e.g. delivery counters are functions-only, but coaches
      // managing their own sends stay permitted).
      allow update: if isSignedIn() && (
        isCoach() ||
        (
          request.auth.uid in resource.data.recipientUids &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['readBy']) &&
          request.resource.data.readBy.hasAll(resource.data.readBy)
        )
      );

      allow delete: if false;

      // ── Public group replies ──
      match /replies/{replyId} {
        // Anyone who can read the parent broadcast can read its replies.
        allow read: if isSignedIn() && (
          isCoach() ||
          request.auth.uid in
            get(/databases/$(database)/documents/broadcasts/$(broadcastId)).data.recipientUids
        );

        // Recipients (and staff) may post, as themselves, if the broadcast
        // allows replies and they are not muted. No private reply path exists —
        // every reply lands in this group-visible collection.
        allow create: if isSignedIn() &&
          !isMuted() &&
          request.resource.data.senderUid == request.auth.uid &&
          get(/databases/$(database)/documents/broadcasts/$(broadcastId)).data.allowReplies == true &&
          (
            isCoach() ||
            request.auth.uid in
              get(/databases/$(database)/documents/broadcasts/$(broadcastId)).data.recipientUids
          );

        // Only staff moderate, and only by soft-deleting (set deleted=true).
        // Replies are never hard-deleted — admins retain the full record.
        allow update: if isCoach() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['deleted', 'deletedBy', 'deletedReason']) &&
          request.resource.data.deleted == true;

        allow delete: if false;
      }
    }

    // ─── Mutes (reply suppression) ──────────────────────────
    // Existence of mutes/{uid} blocks that user from posting replies.
    match /mutes/{uid} {
      allow read: if isSignedIn() && (isOwner(uid) || isCoach());
      allow write: if isCoach();
    }

    // ─── Message Audit Log (append-only oversight) ──────────
    // Written only by Cloud Functions; admins read; no one edits or deletes.
    match /messageAudit/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
